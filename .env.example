# Copiar a .env (no se versiona) y completar.
# Token de Prior Labs (ux.priorlabs.ai -> aceptar licencia de TabPFN-2.5 -> generar token).
TABPFN_TOKEN=

# Opcional: carpeta de caché de pesos de TabPFN (por defecto, la del SO).
# TABPFN_MODEL_CACHE_DIR=

# Opcional: fragmentación de memoria CUDA (útil en la GPU de 6 GB).
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Kaggle: usar ~/.kaggle/kaggle.json o estas variables.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
